#include <bits/stdc++.h>
using namespace std;

class FenwickTree {
private:
    int n;
    vector<long long> bit;
    
public:
    FenwickTree(int size) {
        n = size;
        bit.assign(n + 1, 0);
    }
    
    void add(int idx, long long val) {
        while (idx <= n) {
            bit[idx] += val;
            idx += idx & -idx;
        }
    }
    
    long long query(int idx) {
        long long sum = 0;
        while (idx > 0) {
            sum += bit[idx];
            idx -= idx & -idx;
        }
        return sum;
    }
};

class RangeUpdateRangeQuery {
private:
    int n;
    FenwickTree bit1, bit2;
    
public:
    RangeUpdateRangeQuery(int n) : n(n), bit1(n), bit2(n) {}
    
    // Add v to range [l, r]
    void rangeAdd(int l, int r, long long v) {
        bit1.add(l, v);
        bit1.add(r + 1, -v);
        bit2.add(l, v * (l - 1));
        bit2.add(r + 1, -v * r);
    }
    
    // Get prefix sum [1, x]
    long long prefixSum(int x) {
        return x * bit1.query(x) - bit2.query(x);
    }
    
    // Get range sum [l, r]
    long long rangeSum(int l, int r) {
        return prefixSum(r) - prefixSum(l - 1);
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int N, Q;
    cin >> N >> Q;
    
    RangeUpdateRangeQuery ds(N);
    
    // Initialize with initial loads
    for (int i = 1; i <= N; i++) {
        long long load;
        cin >> load;
        ds.rangeAdd(i, i, load);
    }
    
    // Process commands
    for (int i = 0; i < Q; i++) {
        int type;
        cin >> type;
        
        if (type == 1) {
            int l, r;
            long long v;
            cin >> l >> r >> v;
            ds.rangeAdd(l, r, v);
        } else if (type == 2) {
            int l, r;
            cin >> l >> r;
            cout << ds.rangeSum(l, r) << '\n';
        }
    }
    
    return 0;
}