#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N, Q;
    cin >> N >> Q;
    vector<vector<pair<int, long long>>> adj(N + 1);
    for (int i = 0; i < N - 1; ++i) {
        int a, b; long long w;
        cin >> a >> b >> w;
        adj[a].push_back({b, w});
        adj[b].push_back({a, w});
    }

    const int LOG = 20; // since 2^18=262144 > 2e5, 20 is enough
    vector<vector<int>> up(LOG, vector<int>(N + 1, 0));
    vector<int> depth(N + 1, 0);
    vector<long long> dist(N + 1, 0);

    // iterative stack DFS
    vector<int> order;
    order.reserve(N);
    stack<int> st;
    st.push(1);
    up[0][1] = 0;
    depth[1] = 0;
    dist[1] = 0;
    while (!st.empty()) {
        int u = st.top(); st.pop();
        order.push_back(u);
        for (auto &p : adj[u]) {
            int v = p.first;
            long long w = p.second;
            if (v == up[0][u]) continue;
            up[0][v] = u;
            depth[v] = depth[u] + 1;
            dist[v] = dist[u] + w;
            st.push(v);
        }
    }

    // binary lifting
    for (int k = 1; k < LOG; ++k) {
        for (int v = 1; v <= N; ++v) {
            up[k][v] = up[k-1][ up[k-1][v] ];
        }
    }

    auto lca = [&](int u, int v) {
        if (depth[u] < depth[v]) swap(u, v);
        int diff = depth[u] - depth[v];
        for (int k = 0; k < LOG; ++k) {
            if (diff & (1 << k)) {
                u = up[k][u];
            }
        }
        if (u == v) return u;
        for (int k = LOG - 1; k >= 0; --k) {
            if (up[k][u] != up[k][v]) {
                u = up[k][u];
                v = up[k][v];
            }
        }
        return up[0][u];
    };

    while (Q--) {
        int u, v;
        cin >> u >> v;
        int w = lca(u, v);
        long long total = dist[u] + dist[v] - 2LL * dist[w];
        cout << w << " " << total << "\n";
    }

    return 0;
}