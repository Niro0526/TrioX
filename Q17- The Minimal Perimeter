#include <bits/stdc++.h>
using namespace std;

struct Point {
    long long x, y;
    bool operator<(const Point& other) const {
        return make_pair(y, x) < make_pair(other.y, other.x);
    }
    bool operator==(const Point& other) const {
        return x == other.x && y == other.y;
    }
};

long long cross(const Point& O, const Point& A, const Point& B) {
    return (A.x - O.x) * (B.y - O.y) - (A.y - O.y) * (B.x - O.x);
}

vector<Point> convexHull(vector<Point> points) {
    sort(points.begin(), points.end());
    points.erase(unique(points.begin(), points.end()), points.end());
    
    if (points.size() <= 1) return points;
    
    vector<Point> hull;
    
    // Lower hull
    for (const auto& p : points) {
        while (hull.size() >= 2 && cross(hull[hull.size()-2], hull.back(), p) <= 0) {
            hull.pop_back();
        }
        hull.push_back(p);
    }
    
    // Upper hull
    int lowerSize = hull.size();
    for (int i = (int)points.size() - 2; i >= 0; i--) {
        const auto& p = points[i];
        while ((int)hull.size() > lowerSize && cross(hull[hull.size()-2], hull.back(), p) <= 0) {
            hull.pop_back();
        }
        hull.push_back(p);
    }
    
    hull.pop_back(); // Remove duplicate last point
    
    // If all points are collinear, hull will have only 2 points
    if (hull.size() == 2) {
        // Check if there are more than 2 unique points but all collinear
        if (points.size() > 2) {
            // All collinear - return the two extreme points
            return {points.front(), points.back()};
        }
        return hull;
    }
    
    return hull;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int N;
    cin >> N;
    
    vector<Point> points(N);
    for (int i = 0; i < N; i++) {
        cin >> points[i].x >> points[i].y;
    }
    
    vector<Point> hull = convexHull(points);
    
    // Find starting point: smallest y, then smallest x
    int start = 0;
    for (int i = 1; i < (int)hull.size(); i++) {
        if (hull[i].y < hull[start].y || 
            (hull[i].y == hull[start].y && hull[i].x < hull[start].x)) {
            start = i;
        }
    }
    
    // Rotate hull to start from the found point
    vector<Point> orderedHull;
    for (int i = 0; i < (int)hull.size(); i++) {
        orderedHull.push_back(hull[(start + i) % hull.size()]);
    }
    
    // Ensure counter-clockwise order
    if (orderedHull.size() >= 3) {
        long long area2 = 0;
        for (int i = 0; i < (int)orderedHull.size(); i++) {
            int j = (i + 1) % orderedHull.size();
            area2 += orderedHull[i].x * orderedHull[j].y - orderedHull[i].y * orderedHull[j].x;
        }
        if (area2 < 0) {
            reverse(orderedHull.begin() + 1, orderedHull.end());
        }
    }
    
    cout << orderedHull.size() << "\n";
    for (const auto& p : orderedHull) {
        cout << p.x << " " << p.y << " ";
    }
    cout << "\n";
    
    return 0;
}