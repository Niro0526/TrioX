#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int N;
    cin >> N;
    
    vector<long long> p(N + 1);
    for (int i = 0; i <= N; i++) {
        cin >> p[i];
    }
    
    // dp[i][j] = minimum cost to multiply matrices from i to j
    vector<vector<long long>> dp(N, vector<long long>(N, LLONG_MAX));
    
    // Cost is 0 for single matrix
    for (int i = 0; i < N; i++) {
        dp[i][i] = 0;
    }
    
    // length = number of matrices in the chain
    for (int length = 2; length <= N; length++) {
        for (int i = 0; i <= N - length; i++) {
            int j = i + length - 1;
            for (int k = i; k < j; k++) {
                long long cost = dp[i][k] + dp[k + 1][j] + p[i] * p[k + 1] * p[j + 1];
                if (cost < dp[i][j]) {
                    dp[i][j] = cost;
                }
            }
        }
    }
    
    cout << dp[0][N - 1] << "\n";
    
    return 0;
}