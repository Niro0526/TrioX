#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int N;
    cin >> N;
    
    vector<vector<int>> C(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> C[i][j];
        }
    }
    
    // dp[mask] = minimum total time to assign engineers 0..popcount(mask)-1 
    // to tasks represented by mask (where bit j = 1 means task j is assigned)
    vector<long long> dp(1 << N, LLONG_MAX);
    dp[0] = 0;
    
    for (int mask = 0; mask < (1 << N); mask++) {
        if (dp[mask] == LLONG_MAX) continue;
        
        int engineer = __builtin_popcount(mask);
        if (engineer == N) continue;
        
        for (int task = 0; task < N; task++) {
            if (mask & (1 << task)) continue;  // task already assigned
            if (C[engineer][task] == -1) continue;  // engineer not qualified
            
            int newMask = mask | (1 << task);
            dp[newMask] = min(dp[newMask], dp[mask] + C[engineer][task]);
        }
    }
    
    int fullMask = (1 << N) - 1;
    if (dp[fullMask] == LLONG_MAX) {
        cout << -1 << endl;
    } else {
        cout << dp[fullMask] << endl;
    }
    
    return 0;
}