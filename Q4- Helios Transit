#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, t;
    cin >> n >> t;

    string s;
    cin >> s;

    while (t--) {
        for (int i = 0; i + 1 < n; ) {
            if (s[i] == 'H' && s[i + 1] == 'L') {
                swap(s[i], s[i + 1]);
                i += 2;  // Prevent overlapping swaps in this second
            } else {
                i++;
            }
        }
    }

    cout << s << '\n';

    return 0;
}