#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while (t--) {
        int n, r;
        cin >> n >> r;
        
        if (r == 0) {
            // Construct using (i + j) % n
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    cout << (i + j) % n;
                    if (j < n - 1) cout << ' ';
                }
                cout << '\n';
            }
        } else {
            cout << -1 << '\n';
        }
    }
    
    return 0;
}
