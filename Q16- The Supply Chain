#include <bits/stdc++.h>
using namespace std;

using ll = long long;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<ll> cost(N + 1);
    for (int i = 1; i <= N; i++) {
        cin >> cost[i];
    }

    vector<vector<int>> adj(N + 1);

    for (int i = 0; i < N - 1; i++) {
        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // LOG is enough for N <= 100000
    int LOG = 1;
    while ((1 << LOG) <= N)
        LOG++;

    // up[j][v] = 2^j-th ancestor of v
    vector<vector<int>> up(LOG, vector<int>(N + 1));

    vector<int> depth(N + 1);
    vector<ll> prefix(N + 1);

    // Iterative DFS to avoid recursion stack issues
    vector<int> parent(N + 1, 0);
    vector<int> order;
    order.reserve(N);

    stack<int> st;
    st.push(1);
    parent[1] = 0;
    depth[1] = 0;
    prefix[1] = cost[1];

    while (!st.empty()) {
        int u = st.top();
        st.pop();

        order.push_back(u);

        for (int v : adj[u]) {
            if (v == parent[u])
                continue;

            parent[v] = u;
            depth[v] = depth[u] + 1;
            prefix[v] = prefix[u] + cost[v];

            st.push(v);
        }
    }

    // Binary lifting table
    for (int v = 1; v <= N; v++) {
        up[0][v] = parent[v];
    }

    for (int j = 1; j < LOG; j++) {
        for (int v = 1; v <= N; v++) {
            up[j][v] = up[j - 1][up[j - 1][v]];
        }
    }

    auto lca = [&](int u, int v) {
        if (depth[u] < depth[v])
            swap(u, v);

        // Bring u to the same depth as v
        int diff = depth[u] - depth[v];

        for (int j = 0; j < LOG; j++) {
            if (diff & (1 << j)) {
                u = up[j][u];
            }
        }

        if (u == v)
            return u;

        // Lift both nodes together
        for (int j = LOG - 1; j >= 0; j--) {
            if (up[j][u] != up[j][v]) {
                u = up[j][u];
                v = up[j][v];
            }
        }

        return parent[u];
    };

    int Q;
    cin >> Q;

    for (int q = 0; q < Q; q++) {
        int u, v;
        cin >> u >> v;

        int L = lca(u, v);

        ll answer;

        if (L == 1) {
            // Root has no parent, so subtract nothing extra.
            answer = prefix[u] + prefix[v] - prefix[L];
        } else {
            answer = prefix[u] + prefix[v]
                   - prefix[L]
                   - prefix[parent[L]];
        }

        if (q > 0)
            cout << ' ';

        cout << answer;
    }

    cout << '\n';

    return 0;
}